{
  "version": 2,
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/song/:id",
      "destination": "https://music-api-tq5i.onrender.com/share/song/:id"
    },
    {
      "source": "/album/:id",
      "destination": "https://music-api-tq5i.onrender.com/share/album/:id"
    },
    {
      "source": "/artist/:id",
      "destination": "https://music-api-tq5i.onrender.com/share/artist/:id"
    },
    {
      "source": "/playlist/:id",
      "destination": "https://music-api-tq5i.onrender.com/share/playlist/:id"
    },
    {
      "source": "/track/:provider/:id",
      "destination": "https://music-api-tq5i.onrender.com/share/song/:id"
    },
    {
      "source": "/auth/callback",
      "destination": "/auth/callback/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
